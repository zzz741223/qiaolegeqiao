{
  "name": "qiaolegeqiao",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "一个陪打工人敲完今天的桌面打字伙伴",
  "author": "QiaoLeGeQiao Contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:lan": "node scripts/lan-smoke.cjs",
    "lint": "eslint .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:mac": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false QIAO_ADHOC_SIGN=true electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "dist:mac:arm64": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false QIAO_ADHOC_SIGN=true electron-builder --mac dmg zip --arm64 --publish never",
    "dist:mac:x64": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false QIAO_ADHOC_SIGN=true electron-builder --mac dmg zip --x64 --publish never",
    "dist:mac:signed": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "uiohook-napi": "^1.5.5",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "~5.9.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.qiaolegeqiao.desktop",
    "productName": "敲了个敲",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "afterPack": "scripts/after-pack-mac.cjs",
    "files": [
      "dist/**/*",
      "build/app-icon.png",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "win": {
      "icon": "build/app-icon.png",
      "target": "nsis"
    },
    "mac": {
      "icon": "build/app-icon.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "sign": false,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
